# Copy to .env and fill in what you have. setup.sh/setup.ps1 read this file;
# any var left unset just means that MCP server gets skipped (not written
# with a broken placeholder) until you re-run with it set.

GITHUB_TOKEN=
OBSIDIAN_VAULT_PATH=

# Flip to 1 to skip that part of setup.sh/setup.ps1 entirely
SKIP_FIRECRAWL=
SKIP_BIFROST=
SKIP_LIGHTPANDA=

# Copied as-is into the firecrawl/firecrawl checkout's root .env by
# scripts/setup-firecrawl.sh. Only variables actually referenced by
# docker-compose.yaml take effect there -
# see https://github.com/firecrawl/firecrawl/blob/main/SELF_HOST.md
USE_DB_AUTHENTICATION=false
NUQ_BACKEND=pg
PORT=3002
HOST=0.0.0.0
