# Copy to .env and fill in what you have. setup.sh/setup.ps1 read this file;
# any var left unset just means that MCP server gets skipped (not written
# with a broken placeholder) until you re-run with it set.

GITHUB_TOKEN=
# browser-use runs self-hosted locally (uvx browser-use[cli] --mcp, needs
# uv/uvx on PATH: https://docs.astral.sh/uv/) - this is an OpenAI key, not a
# browser-use one, because its MCP server's LLM client is hardcoded to
# ChatOpenAI. Optional: BROWSER_USE_LLM_MODEL to override the default model.
OPENAI_API_KEY=
BROWSER_USE_LLM_MODEL=
OBSIDIAN_VAULT_PATH=

# Flip to 1 to skip that part of setup.sh/setup.ps1 entirely
SKIP_FIRECRAWL=
SKIP_BIFROST=
SKIP_LIGHTPANDA=
